# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://ride:ride@localhost:5432/ride_together?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Mapbox (mobile) — never commit real tokens
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
# For native Mapbox SDK downloads if still required by version
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Optional
LOG_LEVEL=info
